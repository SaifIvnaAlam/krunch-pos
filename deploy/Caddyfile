# Domains from deploy/.env (Caddy expands {$VAR} from environment).
{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$POS_DOMAIN} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	root * /srv/pos
	handle {
		try_files {path} /index.html
		file_server
	}
}

# Object storage is served by the shared MinIO on the VPS
# (s3.storage.inventivelab.bd); this stack does not proxy it.

# Direct IP access only — must NOT handle named domains (they use blocks above + auto HTTPS)
:80 {
	@ip host 194.164.91.252
	handle @ip {
		@api path /api/*
		handle @api {
			reverse_proxy api:3000
		}

		root * /srv/pos
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
