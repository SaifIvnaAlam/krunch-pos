# Relational production app — steakandmarrow.inventivelab.bd
# Installed to /etc/caddy/conf.d/krunch-v2.caddy.
# Legacy JSON park stays in krunch.caddy (v1-/v2- hostnames → :3001).

steakandmarrow.inventivelab.bd {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:3002
	}

	root * /opt/krunch-pos-v2/deploy/pos-static
	handle {
		try_files {path} /index.html
		file_server
	}
}
