# Legacy v1 JSON stack — parked off the production hostname.
# Installed to /etc/caddy/conf.d/krunch.caddy by the deploy script and pulled in
# via `import /etc/caddy/conf.d/*.caddy` in /etc/caddy/Caddyfile.
#
# Park hostnames: v1-steakandmarrow + v2-steakandmarrow.
# Production relational app is krunch-v2.caddy → steakandmarrow.inventivelab.bd.

v1-steakandmarrow.inventivelab.bd, v2-steakandmarrow.inventivelab.bd {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Postgres web GUI (pgAdmin container, published on 127.0.0.1:8080).
	redir /pgadmin /pgadmin/
	handle_path /pgadmin/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Script-Name /pgadmin
		}
	}

	root * /opt/krunch-pos/deploy/pos-static
	handle {
		try_files {path} /index.html
		file_server
	}
}

# Krunch object storage on the shared MinIO (S3 API on :9000).
# `/media/*` stays on v1 API (legacy MediaAsset rows); production media is served
# from https://steakandmarrow.inventivelab.bd/api/v1/media.
s3.storage.inventivelab.bd {
	handle /media/* {
		rewrite * /api/v1{uri}
		reverse_proxy 127.0.0.1:3001
	}

	reverse_proxy 127.0.0.1:9000 {
		header_up Host {host}
	}
}
