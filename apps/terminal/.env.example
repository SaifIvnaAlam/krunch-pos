# Copy to `.env.local` in this folder (`apps/terminal`).
# Vite only exposes variables prefixed with `VITE_` to the browser.

# --- Option A: production data while developing locally (recommended) ---
# Vite proxies /api to production — same DB as steakandmarrow.inventivelab.bd, no CORS issues.
VITE_API_URL=/api/v1
DEV_API_PROXY_TARGET=https://steakandmarrow.inventivelab.bd
# Stable public URLs for uploaded files (also set on API as MEDIA_PUBLIC_BASE_URL).
VITE_MEDIA_PUBLIC_BASE_URL=https://s3.storage.inventivelab.bd/media
# Run: npm run dev:prod  (terminal only, no local Postgres)

# --- Option B: local API + local Postgres ---
# VITE_API_URL=/api/v1
# DEV_API_PROXY_TARGET=http://localhost:3001
# Run: npm run dev  (starts local Postgres + API + terminal)

# Direct URL (Tauri build or when not using the Vite proxy):
# VITE_API_URL=https://steakandmarrow.inventivelab.bd/api/v1

# Only this email can submit the sign-in form (must exist in DB / seed).
VITE_SEEDED_ADMIN_EMAIL=azmainfahimanjum@gmail.com

# Must match a Branch id in your database (see `packages/database-schema/prisma/seed.ts`).
VITE_DEFAULT_BRANCH_ID=a0000000-0000-4000-8000-000000000001

# Sent on email login; audit logs use this value.
VITE_DEFAULT_TERMINAL_ID=terminal-dev-001

# Images/receipts upload via API presign → PUT to MinIO (see apps/api/.env S3_*).
# No separate VITE storage URL is required.
