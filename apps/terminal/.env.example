# Copy to `.env.local` in this folder (`apps/terminal`).
# Vite only exposes variables prefixed with `VITE_` to the browser.

# --- Default: production relational API (local UI, prod data) ---
# Vite proxies /api to production — same stack as steakandmarrow.inventivelab.bd.
VITE_API_URL=/api/v1
DEV_API_PROXY_TARGET=https://steakandmarrow.inventivelab.bd
VITE_MEDIA_PUBLIC_BASE_URL=https://s3.storage.inventivelab.bd/media
# Phone QR opens this host (must match the API/proxy target — not localhost).
VITE_PUBLIC_APP_URL=https://steakandmarrow.inventivelab.bd
# Run: npm run dev

# --- Optional: isolated local API + local Postgres (never use for real data) ---
# DEV_API_PROXY_TARGET=http://localhost:3001
# Run: npm run dev:local-stack  (starts Docker Postgres + local Nest API)

# Legacy v1 park (JSON stack): https://v2-steakandmarrow.inventivelab.bd
# Direct URL (when not using the Vite proxy):
# VITE_API_URL=https://steakandmarrow.inventivelab.bd/api/v1

# Must match a Branch id in your database (see `packages/database-schema/prisma/seed.ts`).
VITE_DEFAULT_BRANCH_ID=a0000000-0000-4000-8000-000000000001

# Sent on email login; audit logs use this value.
VITE_DEFAULT_TERMINAL_ID=terminal-dev-001

# Images/receipts upload via API presign → PUT to MinIO (see apps/api/.env S3_*).
# No separate VITE storage URL is required.
